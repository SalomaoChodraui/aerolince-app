{
  "name": "aerolince-laudo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Laudos de TC por comando de voz",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build:app": "electron-vite build",
    "dist": "electron-vite build && electron-builder --mac dmg --win nsis",
    "laudo": "tsx src/cli/index.ts",
    "sanitize": "tsx scripts/sanitize-pdfs.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx src/cli/index.ts eval"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "dotenv": "^17.2.0",
    "gray-matter": "^4.0.3",
    "openai": "^6.9.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.1",
    "electron-vite": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.0"
  }
